{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DEBRIEF",
  "version": "0.1.0",
  "identifier": "com.debrief.recorder",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DEBRIEF",
        "width": 560,
        "height": 720,
        "resizable": true,
        "visible": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' http://media.localhost https://media.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Valorant clip recorder",
    "longDescription": "Records Valorant through Windows.Graphics.Capture and NVENC, keeping the last 30 seconds in a replay buffer so a hotkey saves the round that just happened.",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "DEBRIEF",
    "homepage": "https://github.com/Baboyie/valorant-coach"
  }
}
