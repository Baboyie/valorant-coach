# Copy this file to .env and fill in your key.
# Get an Anthropic key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: change the port the server listens on
PORT=8787

# ---------------------------------------------------------------- storage --
# Two backends, picked automatically. With no POSTGRES_URL the server keeps
# matches, notes, comments and scoreboards as files under DEBRIEF_DATA_DIR —
# the right answer for a PC on your desk. Set POSTGRES_URL and it uses that
# instead, which is the only thing that works on a serverless host.
#
# The database only ever holds text and YouTube links. Recordings live on
# YouTube and clips stay on the machine that made them, so the whole team's
# season of review is well under a megabyte.
# DEBRIEF_DATA_DIR=D:\debrief-data
# POSTGRES_URL=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/debrief?sslmode=require

# Scoreboard screenshots when running on Postgres. Vercel sets this for you
# when you create a Blob store; without it, uploads fail and nothing else does.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ---------------------------------------------------------------- sign-in --
# Leave GOOGLE_CLIENT_ID blank and the server stays open, exactly as it was
# before sign-in existed — fine on a trusted LAN.
#
# Set it and everything that *writes* (registering a VOD, posting or deleting a
# comment) requires a signed-in teammate. Reading stays open either way.
#
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized JavaScript origins: http://localhost:8787  (and your LAN/VPS URL)
#
# Only `openid email profile` are used — Google does not treat these as
# sensitive, so there is no verification review and no 7-day token expiry. This
# server never receives or stores a Google access or refresh token, so it can
# never act on anyone's Google account.
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Who is allowed in. Comma-separated, case-insensitive.
# An empty list denies everyone — "any Google account on earth" is not a team.
# DEBRIEF_ALLOWED_EMAILS=you@gmail.com,teammate@gmail.com

# Set to 1 when serving over HTTPS so the session cookie carries `Secure`.
# Leave unset on plain-HTTP LAN, or the browser will drop the cookie and
# nobody will be able to stay signed in.
# DEBRIEF_SECURE_COOKIES=1

# Signs the session cookie. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Unset locally, the server makes one up per run — a restart signs you out and
# nothing worse. In production it is required, because several instances each
# inventing their own would reject each other's cookies and sign people out at
# random, which reads as a flaky app rather than as a missing variable.
# DEBRIEF_SESSION_SECRET=
